						"body": {
							"mode": "raw",
							"raw": "{\n    \"course_id\": 5,\n    \"video_id\": 1,\n    \"question\": \"Explain neural networks based on lectures and study notes.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/query/course/",
							"host": ["{{base_url}}"],
							"path": ["api", "query", "course", ""]
						},
						"description": "RAG query against the merged course vectorstore (video transcripts + study material chunks). Requires the SM to be merged into the course first."
					},
					"response": []
