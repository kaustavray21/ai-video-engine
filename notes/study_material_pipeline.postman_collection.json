							]
						},
						"url": {
							"raw": "{{base_url}}/api/study-materials/upload/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "upload", ""]
						},
						"description": "Upload a ZIP file. Creates a StudyMaterial record (status: pending) and dispatches the Celery processing task."
					},
					"response": []
				},
				{
					"name": "List All Study Materials",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/study-materials/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", ""]
						},
						"description": "Returns all StudyMaterial records with their current status."
					},
					"response": []
				},
				{
					"name": "Study Material Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/status/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "status", ""]
						},
						"description": "Detailed status of a specific SM, including per-file processing results (status, chunk_count, errors)."
					},
					"response": []
				},
				{
					"name": "List Files in Study Material",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/files/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "files", ""]
						},
						"description": "Lists all extracted StudyMaterialFile records with their status, vectorstore path, and chunk count."
					},
					"response": []
				},
				{
					"name": "Retry Failed Study Material",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/retry/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "retry", ""]
						},
						"description": "Re-queues a failed SM. Phase 2 automatically skips files already marked completed — resumes from last checkpoint."
					},
					"response": []
				},
				{
					"name": "Delete Study Material",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/delete/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "delete", ""]
						},
						"description": "Permanently deletes a SM and all resources (zip, raw files, per-file vectorstores, merged vectorstore, DB records). BLOCKED if attached to any course."
					},
					"response": []
				}
			]
		},
		{
			"name": "② Merge to Course",
			"item": [
				{
					"name": "Merge SM into Course",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/merge-to-course/{{course_id}}/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "merge-to-course", "{{course_id}}", ""]
						},
						"description": "Merges the SM complete vectorstore into the course vectorstore. Creates a new merged FAISS index + BM25 at course_vectorstores/. If the course already has an SM attached, the old merged VS is replaced and logged to study_materials_history."
					},
					"response": []
				}
			]
		},
		{
			"name": "③ RAG Queries",
			"item": [
				{
					"name": "Query Full Study Material",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"question\": \"what can you tell me about live video pipeline vulnerabilities ?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/query/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "query", ""]
						},
						"description": "Hybrid BM25+FAISS RAG query against the merged complete vectorstore of the study material. Returns answer + retrieved_sources ordered by BM25 score."
					},
					"response": []
				},
				{
					"name": "Query Full Study Material (Filtered by File Type)",
					"request": {
						"method": "POST",
						"header": [
