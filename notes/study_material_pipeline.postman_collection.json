								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"question\": \"show me all the code examples\",\n    \"filter_file_type\": \"code\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/query/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "query", ""]
						},
						"description": "Same as above but restricts retrieval to a specific file_type. Supported values: code, document, spreadsheet, image, presentation."
					},
					"response": []
				},
				{
					"name": "Query Full Study Material (Filtered by Source File)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"question\": \"summarise this file\",\n    \"filter_source_file\": \"live_video_pipeline_vulnerabilities.svg\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/query/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "query", ""]
						},
						"description": "Restricts retrieval to a single named source file within the merged vectorstore."
					},
					"response": []
				},
				{
					"name": "Query Overview (all files/topics)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"question\": \"what are the topics covered in this study material?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/study-materials/{{sm_id}}/query/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "{{sm_id}}", "query", ""]
						},
						"description": "Triggers the overview strategy: k is boosted, 1 chunk per file is guaranteed, and the file manifest is injected into the prompt so the LLM can enumerate all files."
					},
					"response": []
				},
				{
					"name": "Query Single File (RAG)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"question\": \"what vulnerabilities are described here?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/study-materials/files/{{file_id}}/query/",
							"host": ["{{base_url}}"],
							"path": ["api", "study-materials", "files", "{{file_id}}", "query", ""]
						},
						"description": "RAG query scoped to a single StudyMaterialFile's isolated per-file vectorstore. Useful for deep extraction from one document without noise from others."
					},
					"response": []
				},
				{
					"name": "Course Query (with Study Material)",
					"request": {
						"method": "POST",
						"header": [
