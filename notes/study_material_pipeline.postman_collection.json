	"item": [
		{
			"name": "① Study Material CRUD",
			"item": [
				{
					"name": "Upload Study Material",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "name",
									"value": "test12",
									"type": "text",
									"description": "Unique name for this study material"
								},
								{
									"key": "description",
									"value": "Security architecture notes and vulnerability diagrams",
									"type": "text"
								},
								{
									"key": "zip_file",
									"type": "file",
									"src": "",
									"description": "ZIP archive containing all study material files"
